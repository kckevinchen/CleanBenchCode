{
  "type": "json_schema",
  "json_schema": {
    "name": "typo_judgment",
    "schema": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "typo",
            "clean"
          ]
        },
        "correction": {
          "type": [
            "string",
            "null"
          ],
          "description": "Intended spelling when label=='typo'; null otherwise."
        },
        "flavour": {
          "type": [
            "string",
            "null"
          ],
          "description": "'spelling' | 'punctuation' when label=='typo'; null otherwise."
        },
        "rationale": {
          "type": "string",
          "description": "One short sentence."
        }
      },
      "required": [
        "label",
        "correction",
        "flavour",
        "rationale"
      ],
      "additionalProperties": false
    },
    "strict": true
  }
}
