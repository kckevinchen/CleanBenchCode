{
  "type": "json_schema",
  "json_schema": {
    "name": "typo_column_audit_v4",
    "schema": {
      "type": "object",
      "properties": {
        "typos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "description": "The typo-bearing distinct value, copied verbatim from the input listing."
              },
              "correction": {
                "type": "string",
                "description": "Intended canonical form."
              },
              "flavour": {
                "type": "string",
                "enum": [
                  "spelling",
                  "punctuation",
                  "spacing"
                ]
              },
              "rationale": {
                "type": "string",
                "description": "One short sentence naming the defect."
              }
            },
            "required": [
              "value",
              "correction",
              "flavour",
              "rationale"
            ],
            "additionalProperties": false
          },
          "description": "Every typo found in the column. Empty if the column has no typos."
        }
      },
      "required": [
        "typos"
      ],
      "additionalProperties": false
    },
    "strict": true
  }
}
