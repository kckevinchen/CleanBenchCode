# Copy to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#   # edit .env, then:
#   set -a; source .env; set +a

# Microsoft Foundry Agents Service - used by the web-grounded
# verifier (src/verifier/agent_backend.py).
#
# AZURE_AGENTS_ENDPOINT: project endpoint URL from the Foundry portal,
#   shaped like
#   https://<resource>.services.ai.azure.com/api/projects/<project>
# AZURE_AGENTS_VERIFIER_AGENT_ID: id of a pre-created agent that has
#   the Web Search tool attached. Create it in the Foundry portal or
#   via the SDK; the agent's model + system prompt are managed there
#   (we override `instructions` per run with prompts/verify_entity.yaml).
#
# Auth uses AzureCliCredential, so run `az login` once - no API key
# is stored locally.
AZURE_AGENTS_ENDPOINT=
AZURE_AGENTS_VERIFIER_AGENT_ID=
